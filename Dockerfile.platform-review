# Official Node24.22.1 security release; registry index and linux/amd64 config verified.
# No runtime secrets in build context/args.
FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY . .
ARG SOURCE_COMMIT
ENV LIFEOS_REVIEW_GIT_SHA=${SOURCE_COMMIT}
RUN node scripts/platform-image-metadata.mjs "${SOURCE_COMMIT}"
RUN npm run build -- --webpack
RUN cp -r .next/static .next/standalone/.next/static && cp package-lock.json /tmp/review-committed-lock.json && npm prune --omit=dev --ignore-scripts --no-audit --no-fund && cp /tmp/review-committed-lock.json package-lock.json && node scripts/require-lock.mjs
RUN rm -rf /app/.next/cache

FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ARG SOURCE_COMMIT
# Keep the launcher and source-proof inputs with the pruned application tree.
COPY --from=build /app /app
ENV NODE_ENV=production HOSTNAME=127.0.0.1 PORT=3002 LIFEOS_REVIEW_GIT_SHA=${SOURCE_COMMIT}
LABEL org.opencontainers.image.revision=${SOURCE_COMMIT} org.opencontainers.image.title="LifeOS review candidate" org.opencontainers.image.version="candidate-${SOURCE_COMMIT}"
LABEL lifeos.comparison-only="true"
USER node
CMD ["node","scripts/platform-launch.mjs"]
