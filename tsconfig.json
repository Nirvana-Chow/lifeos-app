{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "components/**/*.tsx",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "next.config.ts",
    "drizzle.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-r516/types/**/*.ts",
    ".next-r516/dev/types/**/*.ts",
    ".next-r517/types/**/*.ts",
    ".next-r517/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/standalone",
    ".next/server",
    ".next/cache",
    ".next/types/* *.ts",
    ".next/dev/types/* *.ts",
    ".next-r516/standalone",
    ".next-r516/server",
    ".next-r516/cache",
    ".next-r516/types/* *.ts",
    ".next-r516/dev/types/* *.ts",
    ".next-r517/standalone",
    ".next-r517/server",
    ".next-r517/cache",
    ".next-r517/types/* *.ts",
    ".next-r517/dev/types/* *.ts"
  ]
}
