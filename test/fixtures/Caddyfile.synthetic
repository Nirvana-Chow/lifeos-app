{
 admin off
 servers {
  strict_sni_host on
 }
}
(common) {
 header {
  X-Content-Type-Options nosniff
  Referrer-Policy no-referrer
  X-Robots-Tag "noindex, nofollow"
  -Server
 }
}
review.example.test {
 import common
 @app path /login /account/* /personal /personal/* /_next/* /api/platform /api/platform/* /
 handle @app {
  reverse_proxy 127.0.0.1:3002 {
   header_up Host review.example.test
   header_up X-Forwarded-Host review.example.test
   header_up X-Forwarded-Proto https
   header_up X-Forwarded-Port 443
   header_up -Forwarded
   header_up -X-Platform-Client
  }
 }
 handle {
  respond "Not Found" 404
 }
}
